.About div.backTitle {
    position: absolute;
    width: 100%;
    height: 850px;
    background:
    linear-gradient(
        to bottom,
        white,
        rgb(255, 237, 213)
    );
}

.About h1 {
    position: absolute;
    top: 50%;
    left: 0;
    margin: 0;
    font-size: 300px;
    font-family: "Noto Sans JP", serif;
    letter-spacing: -5px;
    transform: translate(-25%, -55%) rotate(90deg) scaleY(2);
    transform-origin: center;
    color: rgba(0, 0, 0, 0.08);
}